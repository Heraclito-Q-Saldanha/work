<script lang="rs">
	use crate::util;

	let mut first = 0;
	let mut second = 0;

	effect!(|| {
		if first + second > 10 {
			util::alert("A soma é maior que 10");
		}
	});
</script>

<h1>Calculadora</h1>

<input bind:value={first} step="1">
<input bind:value={second} step="1">

<p>Resultado: {first + second}</p>
