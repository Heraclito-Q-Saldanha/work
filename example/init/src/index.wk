<script lang="rs">
	let mut clicks = 0;
	let mut items: Vec<String> = Vec::new();

	pub fn happy() {
		clicks += 1;
		items.push(format!("Click number {clicks}"));
	}

	pub fn reset() {
		clicks = 0;
		items.clear();
	}
</script>

<h1>Cool page</h1>
<p>Clicks: {clicks}</p>

{#if clicks > 3}
	<p>Many clicks!</p>
{:else if clicks > 0}
	<p>Some clicks</p>
{:else}
	<p>No clicks yet</p>
{/if}

<ul>
	{#each items as item, i}
		<li>{i + 1}. {item}</li>
	{/each}
</ul>

<button onclick="happy()">Happy</button>
<button onclick="reset()">Reset</button>