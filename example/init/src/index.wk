<script lang="rs">
	extern "js" {
		pub fn alert(s: &str);
	}

	let value = "Have a great day!";
	let mut clicks = 0;

	pub fn happy() {
		clicks += 1;
		alert(&format!("Happy #{clicks}: {value}"));
	}

	alert(&format!("Loaded with: {}", value));
</script>

<h1>Cool page</h1>
<button onclick="happy()">Happy</button>
