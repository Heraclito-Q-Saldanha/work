<script lang="rs">
	use crate::components::Counter;

	extern "js" {
		#[wasm_bindgen(js_namespace = console)]
		fn log(s: &str);
	}

	let mut clicks = 0;
	let mut items = Vec::new();
	let mut name = String::new();
	
	let doubled = derived!(clicks * 2);
	let summary = derived!(format!("{name}: {clicks} clicks, doubled {doubled}"));
	
	effect!(log(&summary));

	pub fn happy() {
		clicks += 1;
		items.push(format!("Click number {clicks}"));
	}

	pub fn reset() {
		clicks = 0;
		name.clear();
		items.clear();
	}
</script>

<h1>Cool page</h1>

<button onclick="happy()">Happy</button>
<button onclick="reset()">Reset</button>

<input bind:value={name} placeholder="name">
<p>{summary}</p>

{#if clicks > 3}
	<p>Many clicks!</p>
{:else if clicks > 0}
	<p>Some clicks</p>
{:else}
	<p>No clicks yet</p>
{/if}

<h2>Counters</h2>

<Counter label="fixed" />

{#each items as item, i by i}
	<Counter label={item} />
{/each}


<a href="/about">About</a>